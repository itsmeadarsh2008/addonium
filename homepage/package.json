{
  "name": "addonium-homepage",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "bun --hot run server.ts",
    "dev:client": "bun build ./src/main.tsx --outdir ./public/dist --target browser --format esm --watch",
    "start": "bun run server.ts",
    "build": "bun build ./src/main.tsx --outdir ./public/dist --target browser --format esm --minify",
    "check": "bunx tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf public/dist"
  },
  "dependencies": {
    "@addonium/helpers": "workspace:*",
    "@paper-design/shaders-react": "^0.0.80",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-emoji": "^5.0.2",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-toc": "^9.0.0",
    "unified": "^11.0.5"
  },
  "optionalDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
